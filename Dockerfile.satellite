# Dockerfile.satellite — Checkstack Satellite Agent
#
# Lean image for running health checks from remote locations.
# Connects to the core over WebSocket and executes assigned checks.
#
# Build:
#   docker build -f Dockerfile.satellite -t checkstack-satellite .
#
# Required env vars (set at runtime, never baked in):
#   CHECKSTACK_CORE_URL     — WebSocket URL of the core server (e.g., https://checkstack.example.com)
#   CHECKSTACK_SATELLITE_CLIENT_ID — Satellite client ID (UUID)
#   CHECKSTACK_SATELLITE_TOKEN     — Satellite auth token (shown once on creation)

# Stage 1: Production dependencies only (same pattern as main Dockerfile)
FROM oven/bun:1-alpine AS production-deps
WORKDIR /app

COPY package.json bun.lock ./
COPY core ./core
COPY plugins ./plugins
# `docs` workspace is required for Bun's workspace resolver to succeed
# even though the satellite never runs the docs site.
COPY docs/package.json ./docs/package.json
# Only the three prune scripts (repo-root `scripts/`, NOT the `core/scripts`
# workspace package) are needed, and only in this deps stage - they are never
# copied into the final image, and the satellite has no dependency on them. Copy
# exactly those files so the satellite build isn't coupled to the rest of the
# repo's build tooling.
COPY scripts/prune-for-satellite.ts \
  scripts/satellite-prune.logic.ts \
  scripts/workspace-packages.ts \
  ./scripts/

RUN --mount=type=cache,target=/root/.bun/install/cache \
  for i in 1 2 3; do \
  echo "Attempt $i: Installing production dependencies..." && \
  timeout 300 bun install --frozen-lockfile --production && break || \
  { echo "Attempt $i failed, retrying in 5s..."; sleep 5; }; \
  done || true

# Prune to only the packages the satellite image needs, computed from the
# dependency graph rather than a fragile name pattern. The keep-set is the
# transitive runtime-`dependencies` closure of the satellite PLUS every plugin
# it loads DYNAMICALLY at runtime (`healthcheck-*-backend`/`collector-*-backend`,
# discovered by `strategy-loader.ts`), which are added as extra roots so they -
# and their own transitive deps - are never pruned by accident.
#
# This keeps exactly what runs and deletes the rest (auth/cache/incident/... and
# dev-only core packages). It closes the whole ENOENT-at-startup class the old
# name pattern left open: a static satellite dep that is not a plugin (e.g. the
# `k8s-events-common` telemetry contract), and a shared plugin contract a kept
# backend depends on, are both retained because they are in the closure. Logic +
# safety guard (refuses to prune on a collapsed keep-set) live in
# `scripts/prune-for-satellite.ts`, unit-tested via `scripts/satellite-prune.logic.test.ts`.
RUN bun run scripts/prune-for-satellite.ts

# Stage 2: Production runtime
FROM oven/bun:1-alpine AS runtime
WORKDIR /app

# Sandbox runtime packages (scripts can run ON a satellite, so it needs the
# same enforcement primitives as the core image for the secure FAIL-CLOSED
# default to work out of the box):
#  - bubblewrap: `bwrap` launcher (FS confinement + net namespaces) via
#    UNPRIVILEGED user namespaces (rootless bwrap) - no root needed.
#  - slirp4netns: rootless userspace egress (allowlist + metadata block without
#    CAP_NET_ADMIN / a host uplink).
#  - util-linux: `prlimit` (rlimits) + `unshare` (userns probe).
#  - nftables: `nft` CLI for the fail-closed rootless egress filter.
# The container RUNTIME must apply the SAME two relaxations as the core image
# (see the script-sandbox docs + docker-compose.yml + deploy/k8s): the bundled
# tuned seccomp profile (permits the unprivileged userns + bwrap syscalls) AND a
# /proc unmask (`--security-opt systempaths=unconfined` / k8s `procMount:
# Unmasked`) so bwrap can mount a fresh /proc inside the namespace. The
# combination is VALIDATED in-container against a real syscall trace.
RUN apk update && apk upgrade --no-cache && \
  apk add --no-cache tini bubblewrap slirp4netns util-linux nftables

# Copy production node_modules + all remaining packages
COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=production-deps /app/core ./core
COPY --from=production-deps /app/plugins ./plugins
COPY --from=production-deps /app/package.json ./package.json
COPY LICENSE.md ./

# Bundle the tuned seccomp profile INTO the image so an operator can extract it
# on the satellite host before `docker run` - fully offline / air-gapped, no
# GitHub or core round-trip needed (the profile is version-matched to this
# agent):  docker run --rm <image> print-seccomp > checkstack-userns.json
# (The Docker daemon reads `--security-opt seccomp=<file>` from the HOST at
# create time; a container cannot relax its own seccomp from the inside, so the
# operator must place the file before starting the satellite - see the helper.)
COPY deploy/seccomp/checkstack-userns.json /app/deploy/seccomp/checkstack-userns.json
COPY docker-entrypoint-satellite.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint-satellite.sh

# Dedicated low-privilege identity. NON-ROOT SUPERVISOR MODEL: the satellite
# process itself runs as this uid (see `USER` below), so every sandboxed script
# INHERITS non-root and can never be host-root. Confinement is delivered by
# rootless bwrap via unprivileged user namespaces (in-namespace root maps back
# to this unprivileged host uid). No root-mapped `--uid` drop is needed.
RUN addgroup -g 65532 checkstack && adduser -D -u 65532 -G checkstack checkstack

ENV NODE_ENV=production
# NOTE: CHECKSTACK_SANDBOX_UID/GID are intentionally NOT set - see the core
# Dockerfile. Under the non-root supervisor the script inherits non-root and a
# drop to a different id is neither possible (rootless) nor needed.

HEALTHCHECK NONE

# NON-ROOT supervisor (see the core Dockerfile rationale). The satellite has no
# data/plugins dirs to own; per-run script scratch lives under world-writable
# /tmp, so no extra chown is required.
USER 65532:65532

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/docker-entrypoint-satellite.sh"]
CMD ["bun", "run", "core/satellite/src/index.ts"]
