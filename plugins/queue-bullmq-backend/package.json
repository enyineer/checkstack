{
  "name": "@checkstack/queue-bullmq-backend",
  "version": "0.2.18",
  "type": "module",
  "main": "src/index.ts",
  "checkstack": {
    "type": "backend",
    "pluginId": "queue-bullmq",
    "bundle": [
      "@checkstack/queue-bullmq-common"
    ]
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "lint:code": "eslint . --max-warnings 0",
    "pack": "bunx @checkstack/scripts plugin-pack"
  },
  "dependencies": {
    "@checkstack/backend-api": "workspace:*",
    "@checkstack/queue-api": "workspace:*",
    "@checkstack/queue-bullmq-common": "workspace:*",
    "bullmq": "^5.66.4",
    "zod": "^4.0.0",
    "@checkstack/common": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@checkstack/tsconfig": "workspace:*",
    "@checkstack/scripts": "workspace:*",
    "ioredis-mock": "^8.9.0"
  },
  "description": "Checkstack queue-bullmq-backend plugin",
  "author": {
    "name": "Checkstack contributors"
  },
  "license": "Elastic-2.0"
}
