{
  "name": "@checkstack/integration-script-backend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "checkstack": {
    "type": "backend",
    "pluginId": "integration-script"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "lint:code": "eslint . --max-warnings 0",
    "test": "bun test",
    "pack": "bunx @checkstack/scripts plugin-pack"
  },
  "dependencies": {
    "@checkstack/backend-api": "workspace:*",
    "@checkstack/automation-backend": "workspace:*",
    "@checkstack/automation-common": "workspace:*",
    "@checkstack/common": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "typescript": "^5.0.0",
    "@checkstack/tsconfig": "workspace:*",
    "@checkstack/scripts": "workspace:*",
    "@checkstack/test-utils-backend": "workspace:*"
  },
  "description": "Checkstack integration-script-backend plugin",
  "author": {
    "name": "Checkstack contributors"
  },
  "license": "Elastic-2.0"
}
