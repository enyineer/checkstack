{
  "name": "@checkstack/cache-memory-backend",
  "version": "0.3.6",
  "type": "module",
  "main": "src/index.ts",
  "checkstack": {
    "type": "backend",
    "pluginId": "cache-memory",
    "bundle": [
      "@checkstack/cache-memory-common"
    ]
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "lint:code": "eslint . --max-warnings 0",
    "pack": "bunx @checkstack/scripts plugin-pack"
  },
  "dependencies": {
    "@checkstack/backend-api": "workspace:*",
    "@checkstack/cache-api": "workspace:*",
    "@checkstack/cache-memory-common": "workspace:*",
    "@checkstack/common": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@checkstack/tsconfig": "workspace:*",
    "@checkstack/scripts": "workspace:*"
  },
  "description": "Checkstack cache-memory-backend plugin",
  "author": {
    "name": "Checkstack contributors"
  },
  "license": "Elastic-2.0"
}
