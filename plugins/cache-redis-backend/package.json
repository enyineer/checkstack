{
  "name": "@checkstack/cache-redis-backend",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "checkstack": {
    "type": "backend",
    "pluginId": "cache-redis",
    "bundle": [
      "@checkstack/cache-redis-common"
    ]
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "lint:code": "eslint . --max-warnings 0",
    "pack": "bunx @checkstack/scripts plugin-pack"
  },
  "dependencies": {
    "@checkstack/backend-api": "workspace:*",
    "@checkstack/cache-api": "workspace:*",
    "@checkstack/cache-redis-common": "workspace:*",
    "@checkstack/common": "workspace:*",
    "ioredis": "^5.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@checkstack/tsconfig": "workspace:*",
    "@checkstack/scripts": "workspace:*",
    "ioredis-mock": "^8.9.0"
  },
  "description": "Checkstack cache-redis-backend plugin",
  "author": {
    "name": "Checkstack contributors"
  },
  "license": "Elastic-2.0"
}
