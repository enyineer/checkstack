{
  "name": "@checkstack/e2e",
  "version": "0.0.0",
  "license": "Elastic-2.0",
  "private": true,
  "checkstack": {
    "type": "tooling"
  },
  "type": "module",
  "scripts": {
    "pretest:e2e": "bun run ../../scripts/install-playwright.ts && bun run --filter @checkstack/frontend build && bun run --filter @checkstack/docs build",
    "test:e2e": "bun --env-file=../../.env scripts/with-e2e-postgres.ts",
    "test:e2e:no-db": "playwright test",
    "test:e2e:file": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "lint:code": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@checkstack/ingest-utils": "workspace:*",
    "@checkstack/logstream-common": "workspace:*",
    "@checkstack/scripts": "workspace:*",
    "@checkstack/test-utils-frontend": "workspace:*",
    "@checkstack/tracestream-common": "workspace:*",
    "@checkstack/tsconfig": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@testcontainers/postgresql": "^12.0.3",
    "typescript": "^5.0.0",
    "zod": "^4.2.1"
  }
}
