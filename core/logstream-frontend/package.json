    "@checkstack/healthcheck-frontend": "workspace:*",
    "@checkstack/logstream-common": "workspace:*",
    "@checkstack/signal-common": "workspace:*",
    "@checkstack/telemetry-common": "workspace:*",
    "@checkstack/telemetry-frontend": "workspace:*",
    "@checkstack/tracestream-common": "workspace:*",
    "@checkstack/ui": "workspace:*",
    "@tanstack/react-query": "^5.100.14",
    "lucide-react": "^1.17.0",
    "react": "19.2.7",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@checkstack/scripts": "workspace:*",
    "@checkstack/tsconfig": "workspace:*",
