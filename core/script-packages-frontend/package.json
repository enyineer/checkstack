{
  "name": "@checkstack/script-packages-frontend",
  "version": "0.2.0",
  "license": "Elastic-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "checkstack": {
    "type": "frontend"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.tsx"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsgo -b",
