{
  "name": "@checkstack/frontend",
  "version": "0.17.2",
  "license": "Elastic-2.0",
  "checkstack": {
    "type": "frontend"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./tailwind-preset": "./tailwind-preset.js",
    "./*": "./*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "preview": "vite preview",
    "preview:prod": "vite build && vite preview --port 5173 --strictPort",
    "build:analyze": "VITE_VISUALIZE=true vite build",
    "lint:code": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@checkstack/about-frontend": "workspace:*",
    "@checkstack/announcement-frontend": "workspace:*",
    "@checkstack/auth-frontend": "workspace:*",
    "@checkstack/catalog-frontend": "workspace:*",
    "@checkstack/command-frontend": "workspace:*",
    "@checkstack/common": "workspace:*",
    "@checkstack/dependency-frontend": "workspace:*",
    "@checkstack/frontend-api": "workspace:*",
    "@checkstack/signal-common": "workspace:*",
    "@checkstack/signal-frontend": "workspace:*",
    "@checkstack/status-page-common": "workspace:*",
    "@checkstack/status-page-frontend": "workspace:*",
    "@checkstack/ui": "workspace:*",
    "@module-federation/runtime": "2.7.0",
    "@module-federation/vite": "1.16.15",
    "@orpc/client": "^1.14.4",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "autoprefixer": "^10.4.18",
    "better-auth": "^1.6.13",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.3.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@checkstack/scripts": "workspace:*",
    "@checkstack/tsconfig": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "postcss": "^8.5.23",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^8.0.16",
    "zod": "^4.4.3"
  }
}
