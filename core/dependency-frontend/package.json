{
  "name": "@checkstack/dependency-frontend",
  "version": "0.8.2",
  "license": "Elastic-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "src/index.tsx",
  "checkstack": {
    "type": "frontend"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "lint:code": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@checkstack/catalog-common": "workspace:*",
    "@checkstack/common": "workspace:*",
    "@checkstack/dashboard-frontend": "workspace:*",
    "@checkstack/dependency-common": "workspace:*",
    "@checkstack/frontend-api": "workspace:*",
    "@checkstack/gitops-common": "workspace:*",
    "@checkstack/gitops-frontend": "workspace:*",
    "@checkstack/healthcheck-common": "workspace:*",
    "@checkstack/signal-frontend": "workspace:*",
    "@checkstack/ui": "workspace:*",
    "@xyflow/react": "^12.11.0",
    "lucide-react": "^1.17.0",
    "react": "19.2.7",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@checkstack/scripts": "workspace:*",
    "@checkstack/tsconfig": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react-dom": "19.2.7",
    "typescript": "^5.0.0"
  }
}
