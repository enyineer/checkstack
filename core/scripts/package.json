{
  "name": "@checkstack/scripts",
  "version": "0.6.0",
  "description": "Checkstack tooling: plugin scaffolding, codegen, and the plugin-pack CLI used by external plugin authors.",
  "license": "Elastic-2.0",
  "type": "module",
  "checkstack": {
    "type": "tooling"
  },
  "bin": {
    "checkstack-scripts": "./src/cli.ts"
  },
  "exports": {
    "./scaffold": {
      "import": "./src/scaffold/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync": "bun run src/sync.ts",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@checkstack/common": "workspace:*",
    "ansi-escapes": "^7.3.0",
    "handlebars": "^4.7.8",
    "ink": "^7.0.5",
    "inquirer": "^13.4.1",
    "react": "^19.0.0",
    "tar": "^7.5.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@checkstack/tsconfig": "workspace:*",
    "@types/handlebars": "^4.1.0",
    "@types/inquirer": "^8.2.10",
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
