{
  "name": "{{scoped pluginName}}",
  "version": "0.0.1",
  "description": "{{pluginDescription}}",
  "author": "Checkstack contributors",
  "license": "Elastic-2.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": { "import": "./src/index.ts" }
  },
  "checkstack": {
    "type": "backend",
    "pluginId": "{{pluginBaseName}}",
    "bundle": [
      "{{scoped pluginBaseName}}-common",
      "{{scoped pluginBaseName}}-frontend"
    ]
  },
  "scripts": {
    "dev": "checkstack-dev",
    "pack": "checkstack-scripts plugin-pack",
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "lint:code": "eslint . --max-warnings 0",
    "test": "bun test"
  },
  "dependencies": {
    "@checkstack/backend-api": "workspace:*",
    "@checkstack/common": "workspace:*",
    "{{scoped pluginBaseName}}-common": "workspace:*",
    "@orpc/server": "^1.13.2",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@checkstack/scripts": "workspace:*",
    "@checkstack/dev-server": "workspace:*",
    "@checkstack/backend": "workspace:*",
    "@checkstack/tsconfig": "workspace:*",
    "@checkstack/drizzle-helper": "workspace:*",
    "@checkstack/test-utils-backend": "workspace:*",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2"
  }
}
