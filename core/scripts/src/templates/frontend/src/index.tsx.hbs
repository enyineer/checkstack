import { createFrontendPlugin } from "@checkstack/frontend-api";
import { Boxes } from "lucide-react";
import { {{pluginNameCamel}}Routes, pluginMetadata, {{pluginNameCamel}}Access } from "{{scoped pluginBaseName}}-common";

export default createFrontendPlugin({
  metadata: pluginMetadata,

  // Register routes using typed route definitions. Each route declares a `load`
  // thunk: the framework code-splits the page and wraps it in Suspense + a
  // per-plugin error boundary, so the page chunk is fetched on navigation
  // (never in the initial app load). Use `load` for pages; light, always-on
  // slot extensions (navbar/user-menu) use eager `component` instead.
  routes: [
    {
      route: {{pluginNameCamel}}Routes.routes.home,
      load: () =>
        import("./components/{{pluginNamePascal}}ListPage").then((m) => ({
          default: m.{{pluginNamePascal}}ListPage,
        })),
      title: "{{pluginNamePascal}}",
      accessRule: {{pluginNameCamel}}Access.read,
      // If you TEAM-SCOPE this resource (add instanceAccess in the contract),
      // a management route/nav gated on `{{pluginNameCamel}}Access.manage` MUST
      // also declare `manageCapability`, or team-scoped users (a team grant, no
      // global rule) never see it. The objectType is the exported constant:
      //   manageCapability: { objectType: {{pluginNameCamel}}ResourceTypes.item }
      // (add `parentType` when the create is authorized via a parent gate). The
      // CI guard `bun run check:manage-capabilities` enforces this - see
      // `.claude/rules/rlac.md`. A global-only route needs no manageCapability.
      // `nav` opts this route into the left sidebar. Without it the page is
      // still reachable by URL but not listed. Pick the section heading
      // (group) and icon that fit your plugin.
      nav: {
        group: "Workspace",
        icon: Boxes,
        label: "{{pluginNamePascal}}",
      },
    },
  ],
});

export * from "./api";
