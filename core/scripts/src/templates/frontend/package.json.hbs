{
  "name": "{{scoped pluginName}}",
  "version": "0.0.1",
  "description": "{{pluginDescription}}",
  "author": "Checkstack contributors",
  "license": "Elastic-2.0",
  "type": "module",
  "main": "src/index.tsx",
  "exports": {
    ".": { "import": "./src/index.tsx" }
  },
  "checkstack": {
    "type": "frontend",
    "pluginId": "{{pluginBaseName}}"
  },
  "scripts": {
    "dev": "checkstack-dev",
    "pack": "bunx @checkstack/scripts plugin-pack",
    "typecheck": "tsgo -b",
    "lint": "bun run lint:code",
    "lint:code": "eslint . --max-warnings 0",
    "test:e2e": "bunx playwright test"
  },
  "dependencies": {
    "@checkstack/frontend-api": "workspace:*",
    "@checkstack/common": "workspace:*",
    "{{scoped pluginBaseName}}-common": "workspace:*",
    "@checkstack/ui": "workspace:*",
    "react": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@checkstack/scripts": "workspace:*",
    "@checkstack/dev-server": "workspace:*",
    "@checkstack/frontend": "workspace:*",
    "@checkstack/tsconfig": "workspace:*",
    "@checkstack/test-utils-frontend": "workspace:*",
    "@types/react": "^18.3.1",
    "@playwright/test": "^1.49.0",
    "typescript": "^5.7.2"
  }
}
