# Dependencies (handled by bun install in Docker)
node_modules
**/node_modules

# Git and CI
.git
.github
.changeset

# Development files
.dev
**/.dev
.env
.env.*
*.log

# Build outputs (rebuilt in Docker)
dist/
**/dist/

# Documentation (not needed for runtime)
docs/
# Exception: docs/package.json must reach the build context so Bun's
# workspace resolver doesn't fail with "Workspace not found 'docs'".
# Astro / Starlight live in devDependencies, so --production installs
# nothing extra from this manifest.
!docs/package.json
assets/
*.md
!README.md
!LICENSE.md

# TypeScript build info
*.tsbuildinfo
**/*.tsbuildinfo

# Local state
data/
