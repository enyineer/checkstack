# Dependencies (handled by bun install in Docker)
node_modules
**/node_modules

# Git and CI
.git
.github
.changeset

# Development files
.dev
**/.dev
.env
.env.*
*.log

# Build outputs (rebuilt in Docker)
dist/
**/dist/

# Documentation: the SOURCE is required at build time - the image builds the
# Astro Starlight site to docs/dist and serves it in-app at /checkstack/*. The
# docs source is re-included at the bottom of this file (after the global *.md /
# **/dist/ / assets/ rules) so its .md/.mdx content is not stripped.
assets/
*.md
!README.md
!LICENSE.md

# TypeScript build info
*.tsbuildinfo
**/*.tsbuildinfo

# Local state
data/

# Docs (Astro Starlight) source IS needed to build docs/dist (served at
# /checkstack/*). Re-include it AFTER the global *.md / **/dist/ / assets/
# rules above, then drop only its build output and local deps. Without this the
# in-app user guide 404s (docs/dist builds empty from an empty source tree).
!docs/**
docs/dist/
docs/node_modules/
